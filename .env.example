# ─── Baba Solars API (server/) — copy to server/.env and fill in. NEVER commit .env. ───────────
NODE_ENV=production
HOST=127.0.0.1                 # Nginx proxies to this; do not expose the port publicly
PORT=4000

# PostgreSQL 14+ (the app user only needs rights on its own database)
DATABASE_URL=postgres://babasolars:lata2003@127.0.0.1:5432/babasolars
DATABASE_POOL_MAX=10
DATABASE_SSL=false             # true when the database is on another host with TLS

# The website origin(s) allowed to call the API with cookies (comma-separated).
# Same-origin (Nginx serves site + /api) needs only the public URL here.
CORS_ORIGINS=https://babasolars.com,https://www.babasolars.com,http://localhost:5173
TRUST_PROXY=1                  # 1 = one Nginx in front (correct client IPs, secure cookies)
# COOKIE_DOMAIN=babasolars.com  # only if the API is on a different subdomain
SESSION_TTL_HOURS=12

# Uploaded images (served by Nginx at /uploads/). Keep it OUTSIDE the release folder.
UPLOAD_DIR=/var/lib/babasolars/uploads
UPLOAD_MAX_MB=5                # largest image accepted by POST /api/uploads (JPG, PNG, WebP; checked by content)

# Optional: Redis for the public-site cache and BullMQ background jobs. Leave empty to run without.
REDIS_URL=

LOG_LEVEL=info
# PUBLIC_DIR=/var/www/babasolars/web/public   # optional: website public/ folder, used by data:migrate to check image paths
RATE_LIMIT_ENQUIRIES=20        # website enquiries per IP per 10 min
RATE_LIMIT_LOGIN=10            # sign-in attempts per IP per 15 min, and failed attempts per account per 15 min
RATE_LIMIT_API=600             # API requests per IP per minute

# First run only (npm run db:seed): creates the first admin and owner accounts.
# Remove the passwords from this file after the first seed.
SEED_ADMIN_EMAIL=admin@babasolars.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Admin
SEED_OWNER_EMAIL=owner@babasolars.com
SEED_OWNER_PASSWORD=Owner@12345
SEED_OWNER_NAME=Owner
